{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wardrobe Studio profile schema 1",
  "description": "Editor assistance only. Runtime validation also checks UTF-8 byte limits, uniqueness, option references and installed scheme IDs. Unknown metadata is discarded on import.",
  "type": "object",
  "required": ["schema", "id", "figure", "label", "outfits"],
  "properties": {
    "schema": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "figure": {"allOf": [{"$ref": "#/$defs/id"}, {"not": {"const": "coo"}}]},
    "label": {"$ref": "#/$defs/label"},
    "outfits": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/outfit"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "maxLength": 64},
    "label": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "thumbnail": {"type": "string", "maxLength": 16410, "pattern": "^data:image/(png|webp);base64,[A-Za-z0-9+/]+={0,2}$", "description": "Optional local raster preview, decoded size at most 12 KiB. Entire profile remains limited to 64 KiB UTF-8."},
    "option": {"type": "object", "required": ["id", "label"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "thumbnail": {"$ref": "#/$defs/thumbnail"}}},
    "control": {
      "type": "object", "required": ["id", "label", "options"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "default": {"$ref": "#/$defs/id"}, "options": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/option"}}}
    },
    "variant": {
      "type": "object", "required": ["pick", "scheme"],
      "properties": {"pick": {"type": "object", "maxProperties": 12, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/id"}}, "scheme": {"type": "string", "pattern": "^[a-z0-9-]{1,256}$", "minLength": 1, "maxLength": 256}}
    },
    "outfit": {
      "type": "object", "required": ["id", "label", "controls", "variants"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "thumbnail": {"$ref": "#/$defs/thumbnail"}, "controls": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/control"}}, "variants": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/variant"}}}
    }
  }
}
