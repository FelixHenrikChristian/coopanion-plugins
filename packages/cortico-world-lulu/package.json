{
  "name": "cortico-world-lulu",
  "version": "0.1.6",
  "type": "module",
  "description": "Lulu the capybara for Coopanion, with orange, pajama and cardboard dinosaur outfits. Use alone or switch outfits and the bird bag in Wardrobe Studio's independent wardrobe.",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "coopanion",
    "capybara",
    "lulu"
  ],
  "homepage": "https://github.com/FelixHenrikChristian/coopanion-plugins/tree/main/packages/cortico-world-lulu#readme",
  "bugs": {
    "url": "https://github.com/FelixHenrikChristian/coopanion-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixHenrikChristian/coopanion-plugins.git",
    "directory": "packages/cortico-world-lulu"
  },
  "main": "src/index.js",
  "exports": "./src/index.js",
  "engines": {
    "node": ">=22.10.0"
  },
  "files": [
    "src",
    "web",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/icon.png",
    "assets/looks.jpg",
    "assets/wardrobe.jpg",
    "assets/lulu/*.png",
    "assets/lulu/*.webp"
  ],
  "scripts": {
    "describe": "node scripts/describe.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "pack:check": "node scripts/pack-check.mjs",
    "bundle:previews": "node scripts/bundle-previews.mjs"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "噜噜",
    "icon": "assets/icon.png",
    "describe": "describe.json",
    "webUiClient": "web/client.js",
    "webUiStyle": "web/style.css",
    "locales": {
      "zh": {
        "displayName": "噜噜",
        "description": "水豚噜噜桌宠，含橘子装、睡衣和纸箱恐龙装。可单独使用，也可接入装扮工作室的独立衣橱，切换服装和小鸟包包。"
      },
      "en": {
        "displayName": "Lulu",
        "description": "Lulu the capybara with multiple outfits and a removable bird bag. Use alone or with Wardrobe Studio's independent wardrobe."
      }
    },
    "screenshots": [
      "assets/looks.jpg",
      "assets/wardrobe.jpg"
    ]
  }
}
