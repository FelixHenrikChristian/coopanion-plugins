{
  "name": "cortico-world-coo-home",
  "version": "0.5.0",
  "type": "module",
  "description": "A rainy-night Japanese miniature neighborhood: independent companion life, gardening, shopping and teahouse visits.",
  "license": "MIT",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "engines": {
    "node": ">=22.10.0"
  },
  "keywords": [
    "cortico-world",
    "coopanion",
    "home"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixHenrikChristian/coopanion-plugins.git",
    "directory": "packages/cortico-world-coo-home"
  },
  "files": [
    "src/index.js",
    "src/appearance.js",
    "src/audio-bridge.js",
    "src/navigation.js",
    "src/life.js",
    "src/storage.js",
    "src/garden.js",
    "src/economy.js",
    "src/model.js",
    "src/chat.js",
    "src/brain.js",
    "src/preferences.js",
    "data/home-layout.json",
    "data/navigation-query.js",
    "web",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "assets",
    "src/native-config.js",
    "prompts/HOME_ENVIRONMENT.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "describe": "node scripts/describe.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "three": "0.179.1",
    "esbuild": "0.25.12"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "coo家园",
    "describe": "describe.json",
    "webUiClient": "web/panel.js",
    "webUiStyle": "web/panel.css",
    "locales": {
      "zh": {
        "displayName": "coo家园",
        "description": "雨夜日式微缩街区：独立家园生活、自由种菜、便利店购物卖菜与茶房品茶。"
      },
      "en": {
        "displayName": "Coo Home",
        "description": "A rainy-night Japanese miniature neighborhood: independent companion life, gardening, shopping and teahouse visits."
      }
    },
    "icon": "assets/icon.svg",
    "tags": [
      "game",
      "companion",
      "voice",
      "experimental"
    ],
    "screenshots": [
      "assets/world.jpg",
      "assets/lulu-shop.jpg",
      "assets/lulu-tea.jpg",
      "assets/lulu-garden.jpg",
      "assets/lulu-study.jpg",
      "assets/backpack.jpg",
      "assets/config.jpg",
      "assets/environment.jpg"
    ]
  },
  "author": "FelixHenrikChristian",
  "homepage": "https://github.com/FelixHenrikChristian/coopanion-plugins/tree/main/packages/cortico-world-coo-home#readme",
  "bugs": {
    "url": "https://github.com/FelixHenrikChristian/coopanion-plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
