  "license": "MIT",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "engines": { "node": ">=22.10.0" },
  "keywords": ["cortico-world", "coopanion", "home"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixHenrikChristian/coopanion-plugins.git",
    "directory": "packages/cortico-world-coo-home"
  },
  "files": ["src/index.js", "src/appearance.js", "src/audio-bridge.js", "src/navigation.js", "src/life.js", "src/storage.js", "src/garden.js", "src/model.js", "src/chat.js", "src/brain.js", "data/home-layout.json", "data/navigation-query.js", "web", "describe.json", "README.md", "CHANGELOG.md", "LICENSE", "THIRD_PARTY.md"],
  "scripts": {
    "build": "node build.mjs",
    "describe": "node scripts/describe.mjs",
    "check": "node scripts/check.mjs",
