{
  "name": "cortico-world-coo-home",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "带当前桌宠装扮、日常作息和可交互街区的多房间 3D 小屋。",
  "keywords": [
    "cortico-world"
  ],
  "main": "./world.js",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "Coo小屋",
    "webUiClient": "web/panel.js",
    "webUiStyle": "src/panel.css",
    "describe": "describe.json",
    "screenshots": [
      "assets/room.png"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node build.mjs",
    "describe": "node scripts/package.mjs describe",
    "check": "node scripts/package.mjs check",
    "pack:check": "node scripts/package.mjs pack"
  },
  "devDependencies": {
    "three": "0.179.1",
    "esbuild": "0.25.12"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixHenrikChristian/coopanion-plugins.git",
    "directory": "packages/cortico-world-coo-home"
  },
  "files": [
    "src",
    "world.js",
    "web",
    "describe.json",
    "build.mjs",
    "LICENSE",
    "THIRD_PARTY.md",
    "scripts",
    "tests",
    "README.md",
    "assets",
    "ANIMATIONS.md",
    "CHANGELOG.md"
  ]
}
