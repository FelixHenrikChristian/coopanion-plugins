{
  "tools": [
    {
      "name": "coo_home_look",
      "description": "查看家里各个房间、当前活动、饱腹、精神、热饭和四块地的长势。",
      "tags": [
        "read"
      ],
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "summary": {
        "zh": "看看家里。",
        "en": "Inspect home."
      }
    },
    {
      "name": "coo_home_visit",
      "description": "走到家中设施并使用。tv 看电视、sofa 休息、desk 写字、shelf 读书、tea 泡茶、shoes 换鞋、washer 洗衣、rack 晾衣、stove 做饭、table 吃饭、bed 睡觉、sink 洗漱、bath 泡澡、stroll 街边散步、vendor 买饮料、market 买便当、seeds 买种子、sell 卖菜、plot0–plot3 按长势播种/浇水/采收。会打断未完成的上一个动作。到达并做完才结算。",
      "tags": [
        "write"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "shoes",
              "desk",
              "shelf",
              "washer",
              "rack",
              "tea",
              "seeds",
              "sell",
              "tv",
              "sofa",
              "stove",
              "table",
              "bed",
              "sink",
              "bath",
              "stroll",
              "market",
              "vendor",
              "plot0",
              "plot1",
              "plot2",
              "plot3"
            ]
          }
        },
        "required": [
          "target"
        ],
        "additionalProperties": false
      },
      "summary": {
        "zh": "去家具旁做一件日常小事。",
        "en": "Visit and use a station."
      }
    },
    {
      "name": "coo_home_tv",
      "description": "打开或关闭家里的电视，或选择 0 街区天气、1 海边慢车、2 夜间电台。",
      "tags": [
        "write"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "on": {
            "type": "boolean"
          },
          "channel": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ]
          }
        },
        "required": [
          "on"
        ],
        "additionalProperties": false
      },
      "summary": {
        "zh": "操作小屋里的电视。",
        "en": "Control the TV."
      }
    },
    {
      "name": "coo_home_say",
      "description": "在小屋聊天面板给对方回一句话。",
      "tags": [
        "write"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 360
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "summary": {
        "zh": "在小屋里回复对方。",
        "en": "Reply in the room."
      }
    }
  ],
  "events": [
    {
      "type": "coo-home.visit",
      "description": {
        "zh": "用户给小屋中的 Coo 安排了一项活动。",
        "en": "The visitor gave Coo a household activity."
      }
    },
    {
      "type": "coo-home.chat",
      "description": {
        "zh": "对方在小屋聊天。",
        "en": "A visitor spoke in the room."
      }
    }
  ]
}
