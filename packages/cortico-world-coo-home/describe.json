{
  "tools": [
    {
      "name": "coo_home",
      "strict": true,
      "description": "查询和控制独立的 coo 家园。先用 catalog 找物件、动作和作物。不适用的字段填 null。command/walk 安排单项活动；gardenPlan 用 plotIds 和 cropId 一次安排最多8块田的播种及首次浇水，自动跳过已种同作物或被其他作物占用的田，不会铲除现有作物。批量种田必须用 gardenPlan，不能逐条发送互相覆盖的播种指令。回执 accepted/queued 仅表示安排，只有 recent 或 plans 的 completed 才表示完成。不会操作桌面角色或衣装。",
      "tags": [
        "read",
        "act",
        "write"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "itemId",
          "actionId",
          "cropId",
          "plotIds",
          "position",
          "enqueue"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "status",
              "catalog",
              "command",
              "gardenPlan",
              "walk",
              "cancel",
              "pause",
              "resume"
            ]
          },
          "itemId": {
            "type": [
              "string",
              "null"
            ]
          },
          "actionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "cropId": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "spring-onion",
              "daikon",
              "carrot",
              "cabbage",
              "cucumber",
              "tomato",
              "eggplant",
              "pepper",
              null
            ]
          },
          "plotIds": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 8
          },
          "position": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "enqueue": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  ],
  "events": [
    {
      "type": "coo-home.garden",
      "description": "独立家园的作物成熟与采收近况；不会包含家园聊天记录。",
      "trigger": "piggyback"
    }
  ]
}
